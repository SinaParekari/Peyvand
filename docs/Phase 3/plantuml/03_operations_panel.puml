@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 10
skinparam packageStyle rectangle
left to right direction

actor "Operator\n(اپراتور عملیات)" as Operator
actor "Super Admin\n(مدیر ارشد سامانه)" as SuperAdmin
SuperAdmin -|> Operator

rectangle "3. Operations Panel (پنل عملیات روزمره)" {
  usecase "UC-12: Order Fulfillment & Tracking\n(پردازش ارسال و ثبت کد رهگیری)" as UC12
  usecase "UC-13: Operational Order Cancel\n(لغو عملیاتی سفارش)" as UC13
  usecase "UC-14: Process Payout Requests\n(بررسی شبا، تایید/رد و ثبت پرداخت پایا)" as UC14
}

Operator --> UC12
Operator --> UC13
Operator --> UC14
@enduml
