@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 10
skinparam packageStyle rectangle
left to right direction

actor "Manager\n(ناظر شبکه)" as Manager
actor "Super Admin\n(مدیر ارشد سامانه)" as SuperAdmin
SuperAdmin -|> Manager

rectangle "4. Supervisor Panel (پنل نظارت شبکه)" {
  usecase "UC-15: Approve New Members\n(بررسی و تایید ثبت‌نام اعضای جدید)" as UC15
  usecase "UC-16: Global Tree & Suspension\n(پایش کل درخت و تعلیق/رفع تعلیق اعضا)" as UC16
  usecase "UC-17: Analytical & Financial Reports\n(گزارش‌های تحلیلی فروش، BV و پورسانت)" as UC17
}

Manager --> UC15
Manager --> UC16
Manager --> UC17
@enduml
